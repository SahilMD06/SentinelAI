# Copy to .env.local for local development.
# Leave VITE_API_BASE empty to call same-origin /api — this is what both
# `npm run dev` (via the Vite proxy in vite.config.js) and the Docker/nginx
# setup expect. Only set it if the API is served from a different origin
# (e.g. a separately deployed backend on Render).
# VITE_API_BASE=https://sentinelai-api.onrender.com
