# Copy to .env for local development. Every value below has a working
# default baked into app/config.py — SentinelAI boots fully offline with
# zero configuration. Set only the integrations you want to light up.

# -- Application --------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# -- Database -------------------------------------------------------------
# Leave unset to fall back to a local SQLite file (sentinel_ai.db).
# DATABASE_URL=postgresql+psycopg://sentinelai:sentinelai@localhost:5432/sentinelai

# -- Auth -----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_TTL_MINUTES=720
ALLOW_SELF_REGISTRATION=false

# -- CORS (comma-separated origins allowed to call the API) ---------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# -- Seeding ----------------------------------------------------------------
AUTO_SEED=true

# -- Vector store / RAG -----------------------------------------------------
# auto tries sentence-transformers, then OpenAI, then a deterministic
# hashed-ngram fallback so retrieval always works.
VECTOR_BACKEND=auto
EMBEDDING_MODEL=all-MiniLM-L6-v2
# OPENAI_API_KEY=

# -- Anomaly detection --------------------------------------------------------
ANOMALY_ENABLED=true

# -- Threat intel (leave blank for deterministic offline heuristics) ------
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=

# -- Cache (leave blank for in-memory cache) -------------------------------
# REDIS_URL=redis://localhost:6379/0

# -- Tracing / observability (local | langsmith | phoenix) ------------------
TRACING_EXPORTER=local
# LANGSMITH_API_KEY=
# PHOENIX_COLLECTOR_ENDPOINT=

# -- SSO / OIDC (mock IdP by default; set these for a real provider) ------
SSO_ENABLED=true
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
FRONTEND_URL=http://localhost:5173
SSO_ALLOWED_DOMAINS=sentinelai.io
