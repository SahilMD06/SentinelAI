# Optional — copy to .env at the repo root before `docker compose up` to
# light up live integrations. Every value defaults to blank/off, in which
# case SentinelAI runs entirely on its deterministic offline fallbacks
# (heuristic threat intel, hashed-ngram embeddings, mock SSO, local tracing).
# Per-service defaults live in backend/.env.example and frontend/.env.example.

JWT_SECRET=change-me-to-a-long-random-string-in-production

# -- Production networking ---------------------------------------------------
# Only needed once this stack is deployed somewhere other than localhost —
# set these to the real public URLs of the frontend/backend before deploying
# (otherwise the deployed frontend will be blocked by CORS, and the SSO
# callback will point at the wrong host). Safe to leave unset for local
# `docker compose up`.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback

# Threat intelligence providers
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Embeddings (used only if sentence-transformers is also unavailable)
OPENAI_API_KEY=

# Agentic tracing/observability
LANGSMITH_API_KEY=
PHOENIX_COLLECTOR_ENDPOINT=

# Real OIDC provider (omit to use the built-in mock IdP)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
